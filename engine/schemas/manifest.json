{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Background-compute manifest",
  "description": "The Producer/Consumer contract that lets a long compute outlive its session. The FINISHED JOB writes output_sha256 — never the launcher. doctrine/07 section 4.",
  "type": "object",
  "required": ["schema_version", "output_path", "producer_task", "status", "started_at"],
  "properties": {
    "schema_version": {"type": "integer"},
    "output_path": {"type": "string"},
    "producer_task": {"type": "string"},
    "target_spec": {"type": "object"},
    "code_commit": {"type": ["string", "null"]},
    "env_hash": {"type": ["string", "null"]},
    "seed_entropy": {"type": ["string", "integer", "null"]},
    "started_at": {"type": "string"},
    "expected_completion_at": {"type": ["string", "null"]},
    "projected_wallclock_h": {"type": ["number", "null"]},
    "status": {"type": "string", "enum": ["RUNNING", "COMPLETE", "FAILED", "INFEASIBLE"]},
    "shell_id": {"type": ["string", "null"]},
    "output_sha256": {"type": ["string", "null"]},
    "output_bytes": {"type": ["integer", "null"]},
    "completed_at": {"type": ["string", "null"]},
    "infeasible_reason": {"type": ["string", "null"]},
    "consumers": {"type": "array", "items": {"type": "string"}}
  }
}
